{
  "name": "LoopMarket mobile",
  "dockerComposeFile": "../../docker-compose.yaml",
  "service": "mobile",
  "runServices": [
    "mobile"
  ],
  "workspaceFolder": "/workspace",
  "overrideCommand": false,
  "shutdownAction": "none",
  "initializeCommand": "sh ../scripts/initialize.sh && sh ../scripts/resources.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter"
      ]
    }
  }
}
