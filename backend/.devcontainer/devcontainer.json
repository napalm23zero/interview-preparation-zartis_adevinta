{
  "name": "LoopMarket backend",
  "dockerComposeFile": "../../docker-compose.yaml",
  "service": "backend",
  "runServices": [
    "backend"
  ],
  "workspaceFolder": "/workspace",
  "overrideCommand": false,
  "shutdownAction": "none",
  "initializeCommand": "sh ../scripts/initialize.sh && sh ../scripts/resources.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java"
      ]
    }
  }
}
